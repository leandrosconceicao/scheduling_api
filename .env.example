# Copie para .env e preencha com os valores reais. Nunca versione o .env.

# API
PORT=3000
ENVIROMENT=development
# Obrigatória. Gere uma chave forte, ex.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
CHAVE_JWT=

# MongoDB (obrigatória)
DB_URL=mongodb://usuario:senha@localhost:27017/scheduling_api?authSource=admin

# Redis
CACHE_USERNAME=default
CACHE_PASSWORD=
CACHE_HOST=localhost
CACHE_PORT=6379

# Firebase
# Caminho do JSON da service account (desenvolvimento local; não versionar).
# No App Engine deixe sem definir: a conta de serviço padrão é usada automaticamente.
FIREBASE_CREDENTIALS_PATH=firebase_config.json
FIREBASESTORAGE=seu-projeto.appspot.com
FIREBASEDB=https://seu-projeto-default-rtdb.firebaseio.com

# docker-compose
REDIS_PASSWORD=
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_DATABASE=scheduling_api
